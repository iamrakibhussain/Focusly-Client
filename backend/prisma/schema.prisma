generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PAUSED
}

enum ActivityType {
  TASK_COMPLETED
  FOCUS_SESSION_COMPLETED
  STREAK_UPDATED
  GOAL_ACHIEVED
  ACCOUNT_CREATED
}

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------
model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  password            String    @db.VarChar(255) // Hashed password
  
  // Security & Authentication
  role                Role      @default(USER)
  isVerified          Boolean   @default(false)
  refreshToken        String?   @db.Text
  passwordResetToken  String?   @db.VarChar(255)
  passwordResetExpire DateTime?
  
  // Gamification & Stats
  focusStreak         Int       @default(0) // Current consecutive days
  longestStreak       Int       @default(0)
  totalFocusMinutes   Int       @default(0) // Total time studied overall
  
  // Relations
  settings            UserSettings?
  categories          Category[]
  tasks               Task[]
  focusSessions       FocusSession[]
  activities          Activity[]
  goals               Goal[]
  notifications       Notification[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([email]) // Index for faster login lookups
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Pomodoro Preferences
  pomodoroTime        Int      @default(25) // minutes
  shortBreakTime      Int      @default(5)
  longBreakTime       Int      @default(15)
  sessionsBeforeLong  Int      @default(4)
  
  // UI Preferences
  theme               String   @default("dark")
  
  updatedAt           DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(50)
  color       String   @default("#4F46E5") @db.VarChar(20) // Hex color code
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  
  createdAt   DateTime @default(now())
  
  @@unique([userId, name]) // A user cannot have two categories with the exact same name
}

model Task {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(255)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  
  deadline    DateTime?    // Absolute due date/time
  
  // Relations
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  focusSessions FocusSession[] // Track sessions specifically done for this task
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([userId, status])
  @@index([deadline])
}

model FocusSession {
  id          String        @id @default(uuid())
  duration    Int           // Expected duration in minutes
  actualDuration Int?       // How long it actually ran (if cancelled/paused)
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      SessionStatus @default(IN_PROGRESS)
  
  // Optional Task Link (What were they working on?)
  taskId      String?
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([userId, status])
}

model Goal {
  id             String    @id @default(uuid())
  title          String    @db.VarChar(100)
  targetAmount   Int
  currentProgress Int      @default(0)
  unit           String    @default("units") @db.VarChar(20) // e.g. pages, hrs
  type           GoalType  @default(DAILY)
  
  startDate      DateTime  @default(now())
  endDate        DateTime?
  
  isCompleted    Boolean   @default(false)
  
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([userId, isCompleted])
}

model Activity {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(150)
  description String?      @db.Text
  type        ActivityType
  
  // Optional metadata to store extra details
  metadata    Json?
  
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
  
  @@index([userId, createdAt(sort: Desc)]) // Efficient querying for recent activity feed
}

model Notification {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(150)
  message     String   @db.Text
  isRead      Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([userId, isRead])
}
